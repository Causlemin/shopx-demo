{
  "MongoDB": {
    "ConnectionString": "YOUR_AUTH_MONGODB_CONNECTION_STRING",
    "DatabaseName": "AuthDB",
    "UseTls": false,
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "LogsDB": {
    "ConnectionString": "YOUR_LOGS_MONGODB_CONNECTION_STRING"
  },
  "Jwt": {
    "Secret": "your-super-secret-key-at-least-32-characters-long-for-all-services",
    "Issuer": "auth-service",
